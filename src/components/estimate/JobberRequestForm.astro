---
// Encapsulates Jobber's work-request embed snippet verbatim (IDs/URLs cannot change).
// Card chrome + skeleton sizing + iframe-overflow guard + a11y title live here so
// estimate.astro doesn't need to know anything about the embed's implementation.
---

<div class="rounded-2xl border border-slate-100 bg-white p-6 shadow-sm sm:p-8">
  <div id="jobber-embed-wrapper" class="jobber-embed">
    <div id="ffeb6b49-67c8-423a-8a54-3b6579ca882e-4875304"></div>
    <script
      is:inline
      defer
      src="https://d3ey4dbjkt2f6s.cloudfront.net/assets/static_link/work_request_embed_snippet.js"
      clienthub_id="ffeb6b49-67c8-423a-8a54-3b6579ca882e-4875304"
      form_url="https://clienthub.getjobber.com/client_hubs/ffeb6b49-67c8-423a-8a54-3b6579ca882e/public/work_request/embedded_work_request_form?form_id=4875304"
    ></script>
  </div>
</div>

<style>
  /* Reserve space for the async-loaded widget to reduce layout shift.
     Plain CSS, not a Tailwind arbitrary class, because this is a provisional
     placeholder height with no relation to the design's spacing scale — same
     "absolutely necessary" justification the codebase already uses for
     min-h-[44px] in global.css and EstimateForm.astro. Measured against the
     live default (unconfigured, single-page) Jobber form at ~1066px tall on
     mobile width — re-measure and tune again once the account's real field
     set and single-page-vs-paginated choice are finalized in Jobber's
     dashboard, since both change the real height meaningfully. */
  .jobber-embed {
    min-height: 950px;
  }

  /* Defensive: Jobber's injected iframe must never force horizontal scroll
     on mobile. :global() is required (not stylistic) — Astro's scoped-style
     attribute selector only matches elements present in this component's
     own compiled template, never content injected at runtime by a
     third-party script, so a non-global rule here would silently do
     nothing. No !important needed: max-width clamps the used width
     independent of cascade specificity. */
  .jobber-embed :global(iframe) {
    width: 100%;
    max-width: 100%;
  }
</style>

<script is:inline>
  (function () {
    try {
      var container = document.getElementById('jobber-embed-wrapper');
      if (!container || typeof MutationObserver === 'undefined') return;

      var TITLE = 'HC ServiClean free estimate request form';

      function labelIframe(iframe) {
        var existing = iframe.getAttribute('title');
        if (!existing || !existing.trim()) {
          iframe.setAttribute('title', TITLE);
        }
      }

      function labelAnyIframesIn(node) {
        if (node.tagName === 'IFRAME') {
          labelIframe(node);
        } else if (node.querySelectorAll) {
          var frames = node.querySelectorAll('iframe');
          for (var i = 0; i < frames.length; i++) labelIframe(frames[i]);
        }
      }

      labelAnyIframesIn(container);

      var observer = new MutationObserver(function (mutations) {
        for (var i = 0; i < mutations.length; i++) {
          var added = mutations[i].addedNodes;
          for (var j = 0; j < added.length; j++) {
            if (added[j].nodeType === 1) labelAnyIframesIn(added[j]);
          }
        }
      });

      observer.observe(container, { childList: true, subtree: true });

      // Widget loads once, shortly after script execution — stop watching
      // after a generous window rather than observing indefinitely.
      window.setTimeout(function () {
        observer.disconnect();
      }, 20000);
    } catch (err) {
      // Progressive enhancement only — never let this break the page.
    }
  })();
</script>
