---
import { Image } from 'astro:assets';
import heroBg from '../../assets/images/family-living-room.png';
import BubbleDecor from '../shared/BubbleDecor.astro';
import { averageRating, reviewCount } from '../../data/reviews';
const yearsInBusiness = new Date().getFullYear() - 2010;
const ratingLabel = averageRating.toFixed(1);
const filledStars = Math.round(averageRating);
---

<section
  id="home"
  data-hero
  class="relative overflow-hidden bg-slate-900"
  aria-label="Hero"
>
  <BubbleDecor variant="dark" />

  <div class="relative z-10 grid w-full grid-cols-1 lg:grid-cols-2 lg:min-h-screen">

    <!-- ── LEFT: Copy panel ──────────────────────────────────────────────── -->
    <div class="flex flex-col items-center text-center justify-start pt-28 pb-12 px-[6vw] lg:items-start lg:text-left lg:justify-center lg:pl-[7vw] lg:pr-[4vw] lg:py-28">

      <h1 class="leading-tight text-white">
        <span class="block text-5xl font-bold sm:text-6xl lg:text-7xl xl:text-8xl">
          Spotless homes,<br />happy families.
        </span>
        <span class="mt-4 block text-base font-medium tracking-wide text-white/60 sm:text-lg xl:mt-6 xl:text-xl">
          Professional house cleaning across central Indiana
        </span>
      </h1>

      <p class="mt-5 max-w-md text-base leading-relaxed text-white/50 xl:max-w-lg xl:text-lg">
        Background-checked, full-time staff serving Fishers, Carmel, Noblesville,
        Indianapolis &amp; surrounding communities for over
        <strong class="font-semibold text-white/70">{yearsInBusiness} years</strong>.
        Satisfaction guaranteed on every clean.
      </p>

      <div class="mt-8">
        <a href="/estimate/" class="btn-primary text-base px-10 py-4">
          Get a Free Estimate
        </a>
      </div>

    </div>

    <!-- ── RIGHT: Photo panel ──────────────────────────────────────────────── -->
    <div class="flex flex-col items-center justify-center pb-20 px-[6vw] lg:py-20 lg:pr-[7vw] lg:pl-4">

      <!-- Decorative rings — desktop only -->
      <div class="pointer-events-none absolute inset-0 hidden lg:flex items-center justify-center" aria-hidden="true">
        <div class="h-[560px] w-[560px] rounded-full border border-teal/[0.15] xl:h-[640px] xl:w-[640px] 2xl:h-[760px] 2xl:w-[760px]"></div>
      </div>
      <div class="pointer-events-none absolute inset-0 hidden lg:flex items-center justify-center" aria-hidden="true">
        <div class="h-[480px] w-[480px] rounded-full border border-gold/[0.10] xl:h-[560px] xl:w-[560px] 2xl:h-[660px] 2xl:w-[660px]"></div>
      </div>

      <!-- Photo card -->
      <div class="relative w-full max-w-[520px] overflow-visible xl:max-w-[600px]">

        <div class="overflow-hidden rounded-3xl shadow-2xl ring-1 ring-white/10">
          <Image
            src={heroBg}
            alt="Professionally cleaned home interior in Fishers, Indiana — HC ServiClean"
            width={1200}
            quality={100}
            class="h-[340px] w-full object-cover object-left lg:object-[25%_50%] sm:h-[400px] lg:h-[520px] xl:h-[580px]"
            fetchpriority="high"
            decoding="sync"
            loading="eager"
          />
        </div>

        <!-- Google rating card -->
        <a
          href="/reviews/"
          class="card-rating card-animate absolute top-3 right-3 flex items-center gap-3 rounded-2xl bg-white px-4 py-3 shadow-2xl transition-shadow hover:ring-2 hover:ring-teal/30 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal lg:-top-5 lg:-right-6"
          aria-label={`${ratingLabel} star rating from ${reviewCount} Google reviews — read our reviews`}
        >
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-slate-50 sm:h-10 sm:w-10" aria-hidden="true">
            <svg class="h-5 w-5" viewBox="0 0 24 24">
              <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.27-4.74 3.27-8.1z"/>
              <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.99.66-2.26 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0 0 12 23z"/>
              <path fill="#FBBC05" d="M5.84 14.1a6.6 6.6 0 0 1 0-4.2V7.06H2.18a11 11 0 0 0 0 9.88l3.66-2.84z"/>
              <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84C6.71 7.31 9.14 5.38 12 5.38z"/>
            </svg>
          </span>
          <div>
            <div class="flex items-center gap-1.5">
              <span class="text-base font-bold text-slate-900 sm:text-lg">{ratingLabel}</span>
              <span class="flex gap-0.5" aria-hidden="true">
                {Array.from({ length: 5 }).map((_, i) => (
                  <svg viewBox="0 0 24 24" fill="currentColor" class:list={['h-3.5 w-3.5', i < filledStars ? 'text-gold' : 'text-slate-200']}>
                    <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.007 5.404.433c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.433 2.082-5.006z" clip-rule="evenodd"/>
                  </svg>
                ))}
              </span>
            </div>
            <p class="text-xs font-medium text-slate-500">{reviewCount} Google reviews</p>
          </div>
        </a>

        <!-- Happy Families card -->
        <div class="card-families card-animate absolute bottom-3 left-3 flex items-center gap-2 rounded-2xl bg-white px-3 py-2.5 shadow-2xl sm:gap-3 sm:px-5 sm:py-3.5 lg:-bottom-5 lg:-left-8">
          <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-teal/10 text-base sm:h-10 sm:w-10 sm:text-xl">
            🏠
          </div>
          <div>
            <p class="text-[10px] font-semibold text-slate-400 sm:text-xs">Happy Families</p>
            <p class="text-lg font-bold text-slate-900 sm:text-xl">100+</p>
          </div>
        </div>

      </div>
    </div>

  </div>

</section>

<style>
  /* Rating card: arrow points down into the image */
  .card-rating::after {
    content: '';
    position: absolute;
    bottom: -7px;
    left: 18px;
    width: 0;
    height: 0;
    border-left: 7px solid transparent;
    border-right: 7px solid transparent;
    border-top: 7px solid white;
  }

  /* Families card: arrow points up into the image */
  .card-families::after {
    content: '';
    position: absolute;
    top: -7px;
    right: 18px;
    width: 0;
    height: 0;
    border-left: 7px solid transparent;
    border-right: 7px solid transparent;
    border-bottom: 7px solid white;
  }
</style>

<script>
  document.querySelector('[data-scroll-next]')?.addEventListener('click', () => {
    document.querySelector('[data-hero]')
      ?.nextElementSibling
      ?.scrollIntoView({ behavior: 'smooth' });
  });

  // ── Hero card entrance animation ────────────────────────────────
  (function () {
    const RATING_DELAY  = 500;   // ms before rating card appears
    const DURATION      = 1000;  // ms fade + grow per card
    const SCALE_FROM    = 0.5;   // starting scale (grows to 1.0)
    const FAMILIES_GAP  = 200;   // ms gap between the two cards

    const cardRating   = document.querySelector<HTMLElement>('.card-rating');
    const cardFamilies = document.querySelector<HTMLElement>('.card-families');
    if (!cardRating || !cardFamilies) return;

    // setProperty with 'important' overrides Tailwind's prefers-reduced-motion rule
    // (`transition-duration: 0.01ms !important`) so the animation always plays.
    const set = (el: HTMLElement, prop: string, val: string) =>
      el.style.setProperty(prop, val, 'important');

    const transition = `opacity ${DURATION}ms ease-out, transform ${DURATION}ms cubic-bezier(0.34, 1.3, 0.64, 1)`;

    function animateCard(card: HTMLElement, delay: number) {
      set(card, 'opacity', '0');
      set(card, 'transform', `scale(${SCALE_FROM})`);

      setTimeout(() => {
        set(card, 'transition', transition);
        // rAF ensures the browser paints the hidden state before applying the final state
        requestAnimationFrame(() => {
          set(card, 'opacity', '1');
          set(card, 'transform', 'scale(1)');
        });
      }, delay);
    }

    animateCard(cardRating,   RATING_DELAY);
    animateCard(cardFamilies, RATING_DELAY + DURATION + FAMILIES_GAP);
  })();
</script>
