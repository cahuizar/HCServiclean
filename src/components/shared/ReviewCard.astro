---
import type { Review } from '../../data/reviews';

interface Props {
  review: Review;
}

const { review } = Astro.props;

// Prefer Featurable's relative age; otherwise format the ISO date as "Month Year".
const dateLabel =
  review.relativeTime ||
  (review.date
    ? new Date(review.date).toLocaleDateString('en-US', { month: 'short', year: 'numeric' })
    : '');

const rating = Math.max(0, Math.min(5, Math.round(review.rating)));
---

<figure class="review-card flex h-full flex-col rounded-3xl bg-white p-8 shadow-sm ring-1 ring-slate-100 transition-all duration-300 hover:-translate-y-1 hover:shadow-md">

  <!-- Large decorative quote mark -->
  <div class="mb-4 text-5xl font-bold leading-none text-teal/20 select-none" aria-hidden="true">"</div>

  <!-- Stars -->
  <div class="mb-4 flex gap-1" aria-label={`${rating} out of 5 stars`} role="img">
    {Array.from({ length: 5 }).map((_, i) => (
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="currentColor"
        class:list={['h-5 w-5', i < rating ? 'text-gold' : 'text-slate-200']}
        aria-hidden="true"
      >
        <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.007 5.404.433c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.433 2.082-5.006z" clip-rule="evenodd"/>
      </svg>
    ))}
  </div>

  <!-- Quote -->
  <blockquote class="flex-1">
    <div class="relative">
      <p class="review-text text-sm leading-relaxed text-slate-600">{review.text}</p>
      <span class="review-fade pointer-events-none absolute inset-x-0 bottom-0 h-8 bg-gradient-to-t from-white to-transparent" aria-hidden="true"></span>
    </div>
    <button
      type="button"
      class="review-toggle is-hidden mt-3 items-center gap-1 rounded text-sm font-semibold text-slate-900 transition-colors hover:text-teal-dark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal"
      aria-expanded="false"
    >
      <span class="review-toggle-label">Read more</span>
      <svg class="review-chevron h-4 w-4 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
      </svg>
    </button>
  </blockquote>

  <!-- Author -->
  <figcaption class="mt-6 flex items-center gap-4 border-t border-slate-100 pt-5">
    {review.avatarUrl ? (
      <img
        src={review.avatarUrl}
        alt=""
        width="44"
        height="44"
        loading="lazy"
        decoding="async"
        referrerpolicy="no-referrer"
        class="h-11 w-11 shrink-0 rounded-full object-cover"
      />
    ) : (
      <div
        class="flex h-11 w-11 shrink-0 items-end justify-center overflow-hidden rounded-full bg-slate-300"
        aria-hidden="true"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" class="h-10 w-10 text-white">
          <circle cx="12" cy="9" r="4.2" />
          <path d="M12 14.5c-4.7 0-8.5 2.8-8.5 6.3V24h17v-3.2c0-3.5-3.8-6.3-8.5-6.3z" />
        </svg>
      </div>
    )}
    <div class="min-w-0">
      <p class="font-bold text-slate-900">{review.author}</p>
      <p class="mt-0.5 flex items-center gap-1.5 text-xs text-slate-400">
        <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" aria-hidden="true">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.27-4.74 3.27-8.1z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.99.66-2.26 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0 0 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.1a6.6 6.6 0 0 1 0-4.2V7.06H2.18a11 11 0 0 0 0 9.88l3.66-2.84z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84C6.71 7.31 9.14 5.38 12 5.38z"/>
        </svg>
        <span class="truncate">Verified Google Review{dateLabel ? ` · ${dateLabel}` : ''}</span>
      </p>
    </div>
  </figcaption>
</figure>

<style>
  /* Clamp the review to ~7 lines until expanded. Full text stays in the DOM (SEO + a11y). */
  .review-text {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 7;
    overflow: hidden;
  }
  .review-card.is-expanded .review-text {
    -webkit-line-clamp: unset;
    overflow: visible;
  }

  /* The toggle is laid out as inline-flex; .is-hidden wins over the utility display. */
  .review-toggle {
    display: inline-flex;
  }
  .review-toggle.is-hidden,
  .review-fade.is-hidden {
    display: none;
  }
  .review-card.is-expanded .review-chevron {
    transform: rotate(180deg);
  }
</style>

<noscript>
  <style>
    /* Without JS there's no toggle, so show the full text. */
    .review-text { -webkit-line-clamp: unset; overflow: visible; }
    .review-fade { display: none; }
  </style>
</noscript>

<script>
  function initReviewCards() {
    document.querySelectorAll<HTMLElement>('.review-card').forEach((card) => {
      if (card.dataset.clampReady) return;
      const text = card.querySelector<HTMLElement>('.review-text');
      const btn = card.querySelector<HTMLButtonElement>('.review-toggle');
      const fade = card.querySelector<HTMLElement>('.review-fade');
      const label = card.querySelector<HTMLElement>('.review-toggle-label');
      if (!text || !btn || !fade || !label) return;
      card.dataset.clampReady = '1';

      // Show the toggle + fade only when the clamped text actually overflows.
      const evaluate = () => {
        if (card.classList.contains('is-expanded')) return;
        const overflowing = text.scrollHeight > text.clientHeight + 2;
        btn.classList.toggle('is-hidden', !overflowing);
        fade.classList.toggle('is-hidden', !overflowing);
      };

      btn.addEventListener('click', () => {
        const expanded = card.classList.toggle('is-expanded');
        btn.setAttribute('aria-expanded', expanded ? 'true' : 'false');
        label.textContent = expanded ? 'Read less' : 'Read more';
        fade.classList.toggle('is-hidden', expanded);
      });

      evaluate();

      let t: number | undefined;
      window.addEventListener(
        'resize',
        () => {
          window.clearTimeout(t);
          t = window.setTimeout(evaluate, 150);
        },
        { passive: true }
      );
    });
  }

  initReviewCards();
</script>
