---
import BaseLayout from '../layouts/BaseLayout.astro';
import BubbleDecor from '../components/shared/BubbleDecor.astro';
import { averageRating, reviewCount, googleReviewUrl } from '../data/reviews';

const ratingLabel = averageRating.toFixed(1);
const filledStars = Math.round(averageRating);

const steps = [
  {
    num: '1',
    title: 'Tap the button',
    body: "Click “Leave a Review on Google” — it opens our review page in a new tab.",
  },
  {
    num: '2',
    title: 'Sign in to Google',
    body: "Sign in with your Google account if you aren't already. No account is created for us.",
  },
  {
    num: '3',
    title: 'Share your experience',
    body: 'Pick your star rating and write a sentence or two. That’s it — you’re done!',
  },
];
---

<BaseLayout
  title="Leave a Review | HC ServiClean House Cleaning, Indiana"
  description="Loved your HC ServiClean clean? Leave a quick Google review — it helps our family-owned Indiana cleaning business grow. It takes less than a minute."
  canonical="https://hcserviclean.com/leave-a-review/"
  ogImage="https://hcserviclean.com/images/og-review.jpg"
>
  <!-- ─── INTRO + PRIMARY CTA ───────────────────────────────────────────── -->
  <section
    class="relative overflow-hidden py-24 pt-40 text-center"
    style="background-color: #ffffff; background-image: radial-gradient(rgba(82,182,188,0.18) 1.5px, transparent 1.5px); background-size: 26px 26px;"
    aria-labelledby="review-heading"
  >
    <BubbleDecor variant="light" />
    <div class="relative z-10 container mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-xs font-bold uppercase tracking-widest text-teal">We'd Love Your Feedback</p>
      <h1 id="review-heading" class="mt-3 text-4xl font-bold text-slate-900 sm:text-5xl">
        Loved your clean?<br />Help our family business grow.
      </h1>
      <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-slate-600">
        We're a family-owned cleaning company serving central Indiana since 2010. For a small
        business like ours, word of mouth is everything — a quick review helps other families
        find us and means the world to our team.
      </p>

      <!-- Live rating — social proof -->
      <div class="mt-7 inline-flex items-center gap-2.5 rounded-full bg-white px-5 py-2.5 shadow-sm ring-1 ring-slate-100">
        <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" aria-hidden="true">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.27-4.74 3.27-8.1z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.99.66-2.26 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0 0 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.1a6.6 6.6 0 0 1 0-4.2V7.06H2.18a11 11 0 0 0 0 9.88l3.66-2.84z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84C6.71 7.31 9.14 5.38 12 5.38z"/>
        </svg>
        <span class="text-sm font-bold text-slate-900">{ratingLabel}</span>
        <span class="flex gap-0.5" aria-hidden="true">
          {Array.from({ length: 5 }).map((_, i) => (
            <svg viewBox="0 0 24 24" fill="currentColor" class:list={['h-4 w-4', i < filledStars ? 'text-gold' : 'text-slate-200']}>
              <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.007 5.404.433c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.433 2.082-5.006z" clip-rule="evenodd"/>
            </svg>
          ))}
        </span>
        <span class="text-sm font-medium text-slate-500">· {reviewCount} reviews</span>
      </div>

      <!-- Primary CTA -->
      <div class="mt-9">
        <a
          href={googleReviewUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary gap-3 text-base px-9 py-4"
        >
          <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" aria-hidden="true">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.27-4.74 3.27-8.1z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.99.66-2.26 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0 0 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.1a6.6 6.6 0 0 1 0-4.2V7.06H2.18a11 11 0 0 0 0 9.88l3.66-2.84z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84C6.71 7.31 9.14 5.38 12 5.38z"/>
          </svg>
          Leave a Review on Google
        </a>
        <p class="mt-3 text-sm text-slate-500">It only takes about a minute. Thank you! 💙</p>
      </div>
    </div>
  </section>

  <!-- ─── HOW TO ────────────────────────────────────────────────────────── -->
  <section class="bg-white py-20" aria-labelledby="how-review-heading">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-14 text-center">
        <p class="text-xs font-bold uppercase tracking-widest text-teal">Quick &amp; Easy</p>
        <h2 id="how-review-heading" class="mt-2 text-3xl font-bold text-slate-900 sm:text-4xl">
          How to Leave a Review
        </h2>
        <p class="mx-auto mt-3 max-w-lg text-slate-500">Three quick steps — under a minute, start to finish.</p>
      </div>

      <div class="grid grid-cols-1 gap-10 md:grid-cols-3 md:gap-6">
        {steps.map(({ num, title, body }) => (
          <div class="flex flex-col items-center text-center">
            <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full bg-teal shadow-lg shadow-teal/25">
              <span class="text-xl font-bold text-white" aria-hidden="true">{num}</span>
            </div>
            <div class="mt-6 w-full rounded-3xl bg-slate-50 p-7 ring-1 ring-slate-100">
              <h3 class="font-bold text-slate-900">{title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-500">{body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── WHY IT MATTERS ────────────────────────────────────────────────── -->
  <section class="bg-teal-50 py-16" aria-labelledby="why-review-heading">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <h2 id="why-review-heading" class="text-2xl font-bold text-slate-900 sm:text-3xl">
          Why Your Review Matters
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-slate-700">
          Every review is more than a rating — it's a neighbor telling another neighbor they can
          trust us in their home. Your kind words help our small team keep doing the work we love
          and let more Indiana families discover us. We read every single one, and we're grateful
          for yours.
        </p>
        <p class="mt-5 font-semibold text-slate-900">— The HC ServiClean Family</p>
      </div>
    </div>
  </section>

  <!-- ─── FINAL CTA ─────────────────────────────────────────────────────── -->
  <section
    class="relative py-24 text-center"
    style="background-image: url('/images/contact-parallax.jpg'); background-size: cover; background-position: center;"
    aria-label="Leave a review"
  >
    <div class="absolute inset-0 bg-slate-900/70"></div>
    <div class="relative z-10 px-4">
      <h2 class="text-3xl font-bold text-white sm:text-4xl">Ready to Share Your Experience?</h2>
      <p class="mx-auto mt-3 max-w-xl text-lg text-white/80">
        Thank you for helping our family business grow.
      </p>
      <div class="mt-8">
        <a
          href={googleReviewUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary gap-3 text-base px-9 py-4"
        >
          <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" aria-hidden="true">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.27-4.74 3.27-8.1z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.99.66-2.26 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0 0 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.1a6.6 6.6 0 0 1 0-4.2V7.06H2.18a11 11 0 0 0 0 9.88l3.66-2.84z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84C6.71 7.31 9.14 5.38 12 5.38z"/>
          </svg>
          Leave a Review on Google
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
